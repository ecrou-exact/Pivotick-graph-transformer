{
  "name": "pivotick-transformer-misp",
  "version": "0.0.1",
  "description": "MISP Event to Pivotick graph converter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
