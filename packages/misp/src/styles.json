{
  "defaultMode": "icons",

  "icons": {
    "nodes": {
      "event": { "shape": "hexagon", "color": "#1f6feb", "size": 28 },
      "tag": { "shape": "circle", "color": "#94a3b8", "size": 10 },
      "attribute": { "shape": "circle", "color": "#0ea5e9", "size": 14 },
